# ============================================================
# EMBEDDINGS
# ============================================================
# "local" = FREE, runs on your machine via sentence-transformers, no API key needed
# "openai" = paid, uses OpenAI's text-embedding-3-small (requires OPENAI_API_KEY + billing)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Only needed if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# ============================================================
# GENERATION (answering questions)
# ============================================================
# "gemini"    = FREE tier, no card required, get a key at https://aistudio.google.com/apikey
# "groq"      = FREE tier, no card required, get a key at https://console.groq.com/keys
# "openai"    = paid, requires OPENAI_API_KEY + billing
# "anthropic" = paid, requires ANTHROPIC_API_KEY + billing
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

OPENAI_CHAT_MODEL=gpt-4o-mini
